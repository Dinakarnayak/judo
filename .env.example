# Judo Auto prefers local and free-tier providers. Add only the integrations you want.
# Ollama is local and free to use after downloading models. Install Ollama, pull a model,
# then set OLLAMA_ENABLED=true. For example: ollama pull llama3.2
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2

# Optional provider keys (free tiers/credits depend on provider, model, and account).
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=

# OpenAI and Claude are optional paid API integrations. ChatGPT/Claude subscriptions do not grant API access.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model overrides
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
HF_MODEL=openai/gpt-oss-20b:fastest
OPENAI_MODEL=gpt-5.5
CLAUDE_MODEL=claude-sonnet-4-6

# Required when deploying the Alexa skill adapter
ASK_SKILL_ID=
